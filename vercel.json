{
    "builds": [
        {
            "src": "src/bidzone/wsgi.py",
            "use": "@vercel/python"
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/media/(.*)",
            "dest": "/media/$1"
        },
        {
            "src": "/(.*)",
            "dest": "src/bidzone/wsgi.py"
        }
    ],
    "env": {
        "PYTHONPATH": "src",
        "DJANGO_SETTINGS_MODULE": "bidzone.settings",
        "EMAIL_USER": "@email_user",
        "EMAIL_PASSWORD": "@email_password",
        "DEBUG": "False",
        "ALLOWED_HOSTS": "*",
        "SECRET_KEY": "@secret_key"
    }
}
